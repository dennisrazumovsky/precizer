FROM archlinux@sha256:b21322c663be387c0ed9cbc7bbbfe18e41633ad4e7b7c77cfad45f128be20040 AS arch

RUN set -eux; \
     pacman -Syu --noconfirm --needed base-devel gcc-libs clang sqlite llvm pcre2 upx zip; \
     pacman -Scc --noconfirm

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests
RUN make -j ${BUILD}

CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
