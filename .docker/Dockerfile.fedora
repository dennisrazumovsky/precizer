FROM fedora:latest@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80 AS fedora

RUN set -eux; \
    dnf -y update; \
    dnf -y install \
      which \
      gcc \
      libasan \
      libubsan \
      clang \
      compiler-rt \
      lld \
      make \
      llvm \
      llvm-devel \
      sqlite sqlite-devel \
      glibc-devel glibc-static \
      pcre2 pcre2-devel pcre2-static \
      upx zip; \
    dnf -y clean all; \
    rm -rf /var/cache/dnf /var/cache/libdnf5

WORKDIR /precizer

COPY . /precizer
RUN useradd -m builder && chown -R builder:builder /precizer

USER builder
ARG BUILD=production
ARG COMPILER=
ENV COMPILER=${COMPILER}
ENV TEST_TYPE=tests
RUN make -j ${BUILD}

CMD ["sh", "-c", "make -j ${TEST_TYPE}"]
